{
  "name": "OpenHydra — FBI Crime Data Explorer dashboard",
  "short_name": "OpenHydra",
  "description": "End-to-end analytics dashboard for U.S. crime statistics from the FBI Crime Data Explorer (CDE) API.",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#04070d",
  "background_color": "#04070d",
  "icons": [
    { "src": "/favicon.svg", "type": "image/svg+xml", "sizes": "any" },
    { "src": "/icon-192.png", "type": "image/png", "sizes": "192x192" },
    { "src": "/icon-512.png", "type": "image/png", "sizes": "512x512" },
    { "src": "/icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
  ]
}
